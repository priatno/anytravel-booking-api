option_settings:
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  aws:elasticbeanstalk:application:environment:
    ASPNETCORE_ENVIRONMENT: Production

# Temporary fix for the GDS calls timing out under load — revisit once
# TravelXchangeSoapClient has a real timeout/retry policy instead of relying
# on the load balancer to be patient. Left here since 2025-11 per commit
# message "bump idle timeout, investigate later".
  aws:elb:policies:
    IdleTimeout: 120
