    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AnyTravel.BookingApi</RootNamespace>
    <AssemblyName>AnyTravel.BookingApi</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
